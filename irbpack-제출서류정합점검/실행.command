#!/bin/bash
cd "$(dirname "$0")"

echo "=================================================================="
echo "  irbpack — 제출서류 정합점검"
echo "=================================================================="
echo "  IRB·식약처에 한 봉투로 같이 내는 서류들(연구계획서·동의서·승낙서·"
echo "  CRF·모집공고)을 폴더째 읽어 서류들끼리 말이 다른 곳만 찍어 줍니다."
echo "  문서 하나의 품질은 보지 않습니다 — 문서 사이만 봅니다."
echo ""
echo "    · 대조 항목 12종 (제목·버전·책임자·연락처·대상자 수·연령·방문횟수·"
echo "      소요시간·보상·보관기간·선정제외기준·평가항목) — 늘리지 않습니다"
echo "    · 값이 다르면 어느 쪽이 맞는지 판단하지 않고 근거 문단만 제시"
echo "    · 못 찾은 항목은 '대조불가'로 자백, 못 읽은 문서는 exit 3"
echo ""
echo "  네트워크를 쓰지 않고, 원본 서류를 절대 수정하지 않습니다."
echo ""
echo "  내 서류로 실행 (폴더 하나만 던지면 됩니다):"
echo "    irbpack 제출서류폴더/ --out-dir 정합점검_$(date +%Y%m%d)"
echo ""
echo "  자세한 안내: 사용법.md / README.md"
echo "=================================================================="
echo ""

run() {
  if command -v irbpack >/dev/null 2>&1; then
    irbpack "$@"
  else
    python3 -m irbpack "$@"
  fi
}

DEMO_DIR="$(mktemp -d "${TMPDIR:-/tmp}/irbpack_demo.XXXXXX")"

echo "### 예제 1) 서류 6종이 같은 말을 하는 패킷 (합성)"
echo "    이게 조용해야 툴이 쓸모 있습니다 — 첫 실행에 '치명 12건'이 뜨면"
echo "    아무도 두 번 열지 않기 때문에, 이 예제를 가장 먼저 만들었습니다."
echo "\$ irbpack examples/정합_패킷/"
echo ""
run examples/정합_패킷
echo "    (종료코드: $?  — 0 = 치명 0건)"

echo ""
echo "=================================================================="
echo "### 예제 2) 실제 승인 패킷에서 실측된 결함을 재현한 패킷 (합성)"
echo "    보호자용 동의서만 '1회 또는 다회기', CRF 는 Visit 6개, 동의서 2종의"
echo "    소요시간이 서로 다르고, 프로토콜은 실비인데 동의서는 시간당 정액,"
echo "    모집공고에 개인 휴대전화, 승낙서만 구버전, CRF 에만 있는 평가 폼."
echo "\$ irbpack examples/불일치_패킷/ --out-dir <폴더>"
echo ""
run examples/불일치_패킷 --out-dir "$DEMO_DIR/불일치점검"
echo "    (종료코드: $?  — 1 = 치명 발견)"

echo ""
echo "=================================================================="
echo "### 예제 3) 부속문서 하나가 .hwp 인 패킷 → 판정 불가 (종료코드 3)"
echo "    치명이 있어도 3 이 1 보다 우선합니다 — 다 못 읽었으면"
echo "    '치명 1건'은 판정이 아닙니다."
echo "\$ irbpack examples/판정불가_패킷/"
echo ""
run examples/판정불가_패킷 | sed -n '/^\[커버리지/,$p'
echo "    (종료코드: 3)"

echo ""
echo "=================================================================="
echo "### 예제 4) 개정 축 — 프로토콜만 3회 방문으로 바뀌고 동의서·CRF 는 그대로"
echo "\$ irbpack examples/개정후_패킷/ --baseline examples/개정전_패킷/"
echo ""
run examples/개정후_패킷 --baseline examples/개정전_패킷 | sed -n '/^\[치명\]/,/^\[경고\]/p'

echo ""
echo "=================================================================="
echo "### 예제 5) 문서가 1개면 판정하지 않습니다 (종료코드 2)"
echo "    문서 사이를 보는 툴이라 혼자서는 할 말이 없습니다 (draftcheck 재탕 방지)."
echo "\$ irbpack examples/정합_패킷/연구계획서_v1.2_20260825.docx"
echo ""
run examples/정합_패킷/연구계획서_v1.2_20260825.docx | tail -3
echo "    (종료코드: 2)"

echo ""
echo "=================================================================="
echo "### 만들어진 파일 (예제 2, 임시 폴더 — 끝나면 지웁니다)"
for f in "$DEMO_DIR/불일치점검"/*; do echo "         · $(basename "$f")"; done
echo ""
echo "    불일치목록.csv 앞부분 (전화번호는 언제나 마스킹됩니다):"
python3 - "$DEMO_DIR/불일치점검/불일치목록.csv" <<'PY'
import sys
with open(sys.argv[1], encoding="utf-8-sig") as fh:
    for i, line in enumerate(fh):
        if i >= 4:
            break
        text = line.rstrip("\n")
        print("      " + (text[:140] + " ..." if len(text) > 140 else text))
PY

echo ""
echo "=================================================================="
echo "  ※ 한계 고지"
echo "     · 이 툴은 IRB·식약처 심의 결과를 **예측하지 않습니다.**"
echo "     · 규정 준수 여부를 판정하지 않고, 어느 문서의 값을 채택할지 정하지 않습니다."
echo "     · 문서를 고치지 않습니다 — 정정본·보완답변서를 만들지 않습니다."
echo "     · 표본수·검정력을 재계산하지 않습니다 (그건 powerplan)."
echo "     · .hwp/.hwpx·스캔 PDF 는 읽지 않습니다 — DOCX 로 변환하세요."
echo "     · 선정·제외기준과 평가항목은 서술형이라 가장 약합니다 — 개수만 대조하고"
echo "       항목 단위는 항목추출표.csv 를 사람이 봐야 합니다."
echo "     · 같은 항목을 둘 이상의 문서가 말할 때만 비교합니다. 한 문서에만 있으면 대조불가."
echo "     · 예제 패킷은 전부 합성이며 실제 IRB 문서가 아닙니다."
echo "=================================================================="
echo ""
rm -rf "$DEMO_DIR"
read -p "엔터를 누르면 창이 닫힙니다..." || true
