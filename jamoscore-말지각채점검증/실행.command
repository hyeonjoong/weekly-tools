#!/bin/bash
# jamoscore — 더블클릭하면 번들 예제 4종이 순서대로 돌아갑니다.
cd "$(dirname "$0")" || exit 1

PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
  echo "python3 를 찾지 못했습니다. https://www.python.org 에서 설치해 주세요."
  read -p "엔터를 누르면 창이 닫힙니다..."
  exit 1
fi

cat <<'INTRO'
==========================================================================
  jamoscore — 말지각검사 채점 엑셀 문항 단위 재계산·정합 점검
--------------------------------------------------------------------------
  사람이 손으로 채점한 자음·모음·일음절 검사 엑셀을 읽어
    · 요약표의 %를 문항에서 전수 재계산하고
    · 목표음소 규칙 채점과 사람 채점이 갈리는 문항만 골라내고
    · 아무도 계산하지 않는 음소 혼동 행렬과
      개인 내 변화의 이항 임계차를 내놓습니다.

  점수를 고치지 않습니다. 군간·시점간 검정을 하지 않습니다.
  (그건 statwise · longistat 의 일입니다.)
==========================================================================
INTRO

SPEC=(--subtest "자음:목표=2음절초성,문항=18"
      --subtest "모음:목표=1음절중성,문항=12"
      --subtest "일음절:목표=전체,문항=10"
      --subject-pattern "^S[0-9]+$"
      --answer-key 언어검사_정답
      --summary total-최종)

run_case () {
  echo
  echo "=========================================================================="
  echo "▶ $1"
  echo "   기대 종료코드: $2"
  echo "=========================================================================="
  shift 2
  "$PY" -m jamoscore "$@"
  echo "--- 실제 종료코드: $? ---"
}

run_case "① 정상 파일 — 치명 소견 없음" 0 \
  examples/정상_채점.xlsx "${SPEC[@]}"

run_case "② 문제 있는 파일 — 요약표 값 불일치·불가능한 %·레이아웃 이상" 1 \
  examples/문제있음_채점.xlsx "${SPEC[@]}"

run_case "③ 점수 칸이 반쯤 빈 파일 — 다 못 읽었으므로 '판정 불가'(3이 1보다 우선)" 3 \
  examples/판정불가_채점.xlsx "${SPEC[@]}"

run_case "④ 요약 %만 든 파일 — 판정 없이 거절하고 다른 툴을 가리킴" 2 \
  examples/요약만_있음.csv "${SPEC[@]}"

echo
echo "=========================================================================="
echo "  내 파일로 돌리려면:"
echo "    1) 먼저 구조부터 확인  →  python3 -m jamoscore 내파일.xlsx --inspect \\"
echo "                                --subtest \"자음:목표=2음절초성,문항=18\""
echo "    2) 그 다음 본 실행    →  자세한 사용법은 사용법.md 를 보세요."
echo "=========================================================================="
read -p "엔터를 누르면 창이 닫힙니다..."
