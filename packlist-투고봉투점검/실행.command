#!/bin/bash
# packlist — 더블클릭 실행용. 합성 예제 봉투 5종을 차례로 점검한다.
cd "$(dirname "$0")" || exit 1

cat <<'INTRO'
================================================================
  packlist — 투고 봉투 점검
================================================================
  무엇을 하는가
    저널 포털에 올리기 직전 · 공저자에게 넘기기 직전의 폴더 하나를
    통째로 읽어, 원고가 약속한 그림과 보충자료가 봉투 안에 실제로
    있고 docx 안에 실제로 앵커돼 있는지를 대조합니다.

    draftcheck 는 원고가 스스로 말이 되는지를 보고,
    packlist 는 원고가 약속한 파일이 봉투 안에 있는지를 봅니다.

  내 봉투에 쓰려면
    packlist 투고본_폴더/ --out-dir 봉투점검_결과
    packlist 투고본_폴더/ --inspect          (읽힌 모양만 인쇄)
    packlist 이번회차/ --baseline 지난회차/   (앵커 회귀 검출)

  아래는 동봉된 합성 예제 5종입니다. 실제 원고는 들어 있지 않습니다.
================================================================
INTRO

PY=python3
command -v python3 >/dev/null 2>&1 || PY=python

echo
echo "[준비] 합성 예제 봉투를 만듭니다..."
"$PY" examples/_make_examples.py || { echo "예제 생성 실패"; read -r -p "엔터를 누르면 창이 닫힙니다..." || true; exit 1; }

run() {
  echo
  echo "----------------------------------------------------------------"
  echo "  $1"
  echo "----------------------------------------------------------------"
  shift
  "$PY" -m packlist "$@"
  echo "  → 종료코드 $?"
}

run "① 정상 봉투 — 약속한 보충자료가 전부 있습니다 (기대 종료코드 0)" \
    examples/01_정상봉투 --manuscript 원고_synthetic_v3.docx
run "② 고아 이미지가 있는 봉투 — 그림이 본문 앵커를 잃었습니다 (기대 종료코드 1)" \
    examples/02_고아있음
run "③ docx 가 손상된 봉투 — 다 읽지 못했으므로 판정하지 않습니다 (기대 종료코드 3)" \
    examples/03_판정불가
run "④ 원고 1개뿐인 폴더 — 대조할 봉투가 아닙니다 (기대 종료코드 2)" \
    examples/04_거절_원고만
run "⑤ 지난 회차 대비 — 붙어 있던 그림이 떨어졌습니다 (기대 종료코드 1) ★이 툴의 존재 이유" \
    examples/05_앵커회귀_이번회차 --baseline examples/05_앵커회귀_지난회차

echo
echo "================================================================"
echo "  종료코드: 0 이상 없음 · 1 치명 있음 · 2 판정 없이 거절 · 3 판정 불가"
echo "  마지막의 [커버리지 자백] 을 꼭 읽으세요 —"
echo "  리포트에 안 나온 항목이 '일치'라는 뜻이 아닙니다."
echo "  자세한 사용법: 사용법.md / README.md"
echo "================================================================"
echo
read -r -p "엔터를 누르면 창이 닫힙니다..." || true
